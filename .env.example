# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_WRITE_TOKEN=

# Contact form email delivery (Resend)
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Testing: Inkspilled <onboarding@resend.dev>
# Production: use an address on a verified domain, e.g. Inkspilled <hello@inkspilled.ae>
RESEND_FROM_EMAIL=Inkspilled <onboarding@resend.dev>
# Optional override for the inbox that receives inquiries.
# Required when using onboarding@resend.dev (must be your Resend account email).
# Production: omit to default to hello@inkspilled.ae
RESEND_TO_EMAIL=
