# Sanity CMS — copy to .env.local
NEXT_PUBLIC_SANITY_PROJECT_ID=pufzyop7
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Optional: required for npm run sanity:seed
SANITY_API_WRITE_TOKEN=

# Contact form email delivery (Resend)
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Resend cannot send from gmail.com. Use onboarding@resend.dev for testing,
# or a verified domain address like hello@inkspilled.ae in production.
RESEND_FROM_EMAIL=Inkspilled <onboarding@resend.dev>
# Free-tier onboarding sender can only deliver to your Resend account email.
RESEND_TO_EMAIL=hello@inkspilled.ae
